{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(date:*)",
      "Bash(mv:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git rm:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "V=${NEXUS_VAULT_PATH:-$(pwd)}; [ -f \"$V/.claude/skills/session-context/scripts/update-inbox-count.sh\" ] && bash \"$V/.claude/skills/session-context/scripts/update-inbox-count.sh\" 2>/dev/null; exit 0",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "V=${NEXUS_VAULT_PATH:-$(pwd)}; [ -f \"$V/.claude/skills/session-context/scripts/session-start.sh\" ] && bash \"$V/.claude/skills/session-context/scripts/session-start.sh\" 2>/dev/null; exit 0",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "V=${NEXUS_VAULT_PATH:-$(pwd)}; [ -f \"$V/.claude/skills/session-context/scripts/session-end.sh\" ] && bash \"$V/.claude/skills/session-context/scripts/session-end.sh\" 2>/dev/null; exit 0",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ]
  }
}
